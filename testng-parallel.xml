<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Devices are driven entirely by TestData/DeviceConfig.xlsx (sheet "Devices",
  columns DeviceName | OSVersion | Execute). Add/remove rows there to change
  which devices run - no XML edits needed.

  data-provider-thread-count controls how many devices run at once; keep it
  <= your BrowserStack account's parallel session limit.
-->
<suite name="Titan Mobile Automation - Parallel Login Flow (v2)" data-provider-thread-count="2">

    <test name="V2 Login - Device Matrix">
        <classes>
            <class name="com.titan.eyestage.v2.LoginTest"/>
        </classes>
    </test>

</suite>
