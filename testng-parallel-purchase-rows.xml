<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Sibling to testng-parallel-purchase.xml: that suite parallelizes across DEVICES (one
  PurchaseTest instance per TestData/DeviceConfig.xlsx row). This suite instead runs on a
  single fixed device and parallelizes across that device's two LOGINS (MobileNumber/Password
  and MobileNumber2/Password2 in DeviceConfig.xlsx).

  ParallelRowsPurchaseTest.createInstances() (a @Factory method) creates one instance per
  login: the first login gets the Wallet and Google Pay rows from
  TestData/PurchaseData-v2.xlsx, the second gets every other payment method. parallel=
  "instances" runs the two logins side by side, while each login's own rows run one after
  another - so a login (and its server-side cart) is never used by two rows at once.

  thread-count is the number of logins running at once; keep it <= your BrowserStack
  account's parallel session limit.
-->
<suite name="Titan Mobile Automation - Parallel Purchase Rows (v2)" parallel="instances" thread-count="2">

    <test name="V2 Purchase - Parallel Payment Method Rows">
        <classes>
            <class name="com.titan.eyestage.v2.ParallelRowsPurchaseTest"/>
        </classes>
    </test>

</suite>
